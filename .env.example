# ============================================
# Edge-Cloud Orchestrator - Environment Setup
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control

# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ============================================
# CRITICAL SECURITY SETTINGS
# ============================================

# JWT Secret - MUST be at least 32 characters
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long

# Encryption Key - MUST be at least 32 characters for AES-256
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your-encryption-key-minimum-32-chars

# Service Token for inter-service communication
SERVICE_TOKEN=your-service-token-minimum-32-chars

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://edgecloud:edgecloud123@localhost:5432/edgecloud
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=edgecloud
DATABASE_USER=edgecloud
DATABASE_PASSWORD=edgecloud123
POSTGRES_PASSWORD=edgecloud123
POSTGRES_REPLICATION_PASSWORD=changeme_replication

# For CockroachDB
# DATABASE_URL=postgresql://root@localhost:26257/edgecloud?sslmode=disable

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SENTINELS=redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379
REDIS_SENTINEL_NAME=mymaster

# ============================================
# Kafka Configuration
# ============================================
KAFKA_BROKERS=localhost:9092,kafka-1:9092,kafka-2:9092,kafka-3:9092

# ============================================
# ALLOWED ORIGINS (CORS) Configuration
# ============================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-domain.com

# ============================================
# Carbon & Energy Tracking
# ============================================
ELECTRICITY_MAPS_API_KEY=your-api-key-here
CARBON_WEIGHT=0.2

# ============================================
# S3 / Object Storage (Models & Reports)
# ============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
MODEL_STORAGE_BUCKET=edge-cloud-models
REPORTS_BUCKET=edgecloud-reports

# ============================================
# ML & Scheduling Policy
# ============================================
ML_MODEL_MIN_VERSION=1.0.0
MIN_MODEL_VERSION=1.0.0
SCHEDULING_INTERVAL=5000

# ============================================
# OpenTelemetry & Tracing
# ============================================
OTEL_ENABLED=false
OTEL_DEBUG=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# ============================================
# Kubernetes & Infrastructure
# ============================================
K8S_SECRETS_DIR=/etc/edgecloud/secrets
KUBECONFIG=~/.kube/config
SECRET_BACKEND=env # env, vault, or k8s

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ============================================
# mTLS Configuration (Production Only)
# ============================================
MTLS_ENABLED=false
MTLS_CA_CERT=/path/to/ca.crt
MTLS_SERVER_CERT=/path/to/server.crt
MTLS_SERVER_KEY=/path/to/server.key

# ============================================
# Vault Configuration (Production Only)
# ============================================
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=your-vault-token

# ============================================
# Frontend Configuration
# ============================================
VITE_API_URL=http://localhost:80
VITE_WS_URL=ws://localhost:3004/ws
VITE_ENABLE_AUTH=true

# ============================================
# Docker Configuration
# ============================================
# For docker-compose, use these service names:
# DATABASE_HOST=cockroachdb-1
# REDIS_URL=redis://redis:6379
# KAFKA_BROKERS=kafka-1:9092,kafka-2:9092,kafka-3:9092

# ============================================
# Edge Agent Configuration
# ============================================
NODE_ID=node-1
NODE_NAME="Edge Node 1"
NODE_LOCATION="Region-A"
ORCHESTRATOR_URL=http://localhost:3090
REQUEST_SIGNATURE_SECRET=your-agent-signature-secret-minimum-32-chars

# ============================================
# Performance & Retention
# ============================================
METRIC_RETENTION_DAYS=7     # Days to retain node metrics (default: 7)
ML_OUTCOME_RETENTION=100000 # Max outcome log rows for ML training (default: 100k)

# ============================================
# Git Integration
# ============================================
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# ============================================
# Alerting & Webhooks
# ============================================
ALERT_WEBHOOK_URL=
ALERT_THROTTLE_MS=60000

# ============================================
# AutoHealer Configuration
# ============================================
HEALER_COOLDOWN_MS=60000
HEALER_MAX_CONCURRENT=5
HEALER_K8S_ENABLED=true
HEALER_K8S_NAMESPACE=default
PROMETHEUS_URL=http://prometheus:9090

# ============================================
# Security Notes:
# ============================================
# 1. NEVER use default credentials in production
# 2. Generate random secrets using:
#    - OpenSSL: openssl rand -base64 32
#    - Node.js: require('crypto').randomBytes(32).toString('base64')
# 3. Store secrets in a secure vault (HashiCorp Vault, AWS Secrets Manager)
# 4. Rotate secrets regularly
# 5. Use different secrets for each environment

{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "project": "./tsconfig.json"
  },
  "plugins": ["@typescript-eslint", "import", "simple-import-sort"],
  "extends": [],
  "rules": {
    "import/no-internal-modules": "off"
  },
  "overrides": [],
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    "*.js",
    "*.d.ts",
    "coverage",
    ".eslintrc.js",
    "scratch",
    "docs"
  ]
}

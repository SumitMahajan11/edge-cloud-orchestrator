#!/bin/sh

# GSD Pre-commit Hook
# Runs linting and formatting checks before commits

echo "🔍 Running GSD pre-commit checks..."

# Check if we're in a git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "❌ Not in a git repository"
    exit 1
fi

# Run linting
echo "📏 Running linter..."
if ! npm run lint; then
    echo "❌ Linting failed. Please fix the issues before committing."
    echo "💡 Run 'npm run lint:fix' to automatically fix some issues."
    exit 1
fi

# Run type checking
echo "🔧 Running type check..."
if ! npm run typecheck; then
    echo "❌ Type checking failed. Please fix the type errors before committing."
    exit 1
fi

# Run tests
echo "🧪 Running tests..."
if ! npm run test:ci; then
    echo "❌ Tests failed. Please fix the failing tests before committing."
    exit 1
fi

echo "✅ All GSD checks passed!"
exit 0
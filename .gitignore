# Certificates and private keys — NEVER commit these
*.crt
*.pfx
*.pem
*.key
*.p12
*.cer
*.der
certs/
# Exception: example/template files only
!*.example.crt

# Backup and temporary files
*.backup
*.bak
*.orig
*.tmp

# Build artifacts (additional patterns)
coverage/.tmp/

# ML Models (trained artifacts - do not commit)
packages/ml-scheduler/models/*.xgb.json
packages/ml-scheduler/models/*.joblib
packages/ml-scheduler/models/*.bin
packages/ml-scheduler/models/*.weights
packages/ml-scheduler/training/__pycache__/
packages/ml-scheduler/**/*.pyc

# Exception: Keep metadata templates and latest.json
!packages/ml-scheduler/models/latest.json
!packages/ml-scheduler/models/README.md

# Test outputs and results
**/test_output.txt
**/test-results/
**/*.test-output
tests/load/results/*.json

# Generated outputs (do not commit)
coverage/
dist/
*.log
*.tmp
docs/archive/
target_clippy/
target/
query_engine-*.node
query_engine-*.node.tmp*


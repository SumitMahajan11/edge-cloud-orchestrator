#!/bin/sh
CERT_FILES=$(git diff --staged --name-only | grep -E '\.(crt|pfx|pem|key|p12|cer|der)$')
if [ -n "$CERT_FILES" ]; then
  echo "BLOCKED: Certificate/key files cannot be committed:"
  echo "$CERT_FILES"
  echo "Store certificates in HashiCorp Vault. See infra/vault/ for documentation."
  exit 1
fi

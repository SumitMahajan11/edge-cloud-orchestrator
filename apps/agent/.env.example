# ==============================================================================
# Edge Agent (.env.example)
# ==============================================================================

# [REQUIRED] Unique identifier for this edge node
NODE_ID=edge-node-001

# [OPTIONAL] Human-readable display name for this node (default: Edge Node)
NODE_NAME=Edge Node Alpha

# [OPTIONAL] Physical or logical geographic location of the node (default: Local)
NODE_LOCATION=us-east-1

# [OPTIONAL] Application execution environment: development | production | test (default: development)
NODE_ENV=development

# [OPTIONAL] Local server port for the agent daemon (default: 4001)
PORT=4001

# [OPTIONAL] Logging severity: fatal | error | warn | info | debug | trace (default: info)
LOG_LEVEL=info

# [REQUIRED] Target orchestrator API base URL
ORCHESTRATOR_URL=http://localhost:3090

# [OPTIONAL] Comma-separated list of allowed origins for CORS (default: http://localhost:5173,http://localhost:3000)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# [REQUIRED] Shared JWT secret for validating tokens from orchestrator (min 32 chars)
JWT_SECRET=your-agent-jwt-secret-min-32-chars-long-placeholder

# [REQUIRED] Shared secret for HMAC-SHA256 request signature verification (min 1 char)
REQUEST_SIGNATURE_SECRET=your-agent-request-signature-secret-placeholder

# [OPTIONAL] Optional local API key to restrict daemon API access
# API_KEY=

# [OPTIONAL] Enforce local API key authorization on all requests: true | false (default: false)
REQUIRE_API_KEY=false

# [OPTIONAL] Enable mutual TLS authentication for inbound connections: true | false (default: false)
ENABLE_MTLS=false

# [OPTIONAL] Path to the agent server TLS certificate (default: ./certs/server.crt)
TLS_CERT_PATH=./certs/server.crt

# [OPTIONAL] Path to the agent server TLS private key (default: ./certs/server.key)
TLS_KEY_PATH=./certs/server.key

# [OPTIONAL] Path to the trusted Certificate Authority (CA) root certificate (default: ./certs/ca.crt)
TLS_CA_PATH=./certs/ca.crt

# [OPTIONAL] Rate limiting sliding window in milliseconds (default: 60000)
RATE_LIMIT_WINDOW_MS=60000

# [OPTIONAL] Maximum requests allowed per rate limiting window (default: 100)
RATE_LIMIT_MAX=100

# [OPTIONAL] Regular expression restricting permitted Docker image repositories (default: ^[^:]+(?::(?!latest)[a-zA-Z0-9._-]+)?$)
IMAGE_ALLOWLIST_REGEX=^[^:]+(?::(?!latest)[a-zA-Z0-9._-]+)?$

# [OPTIONAL] Custom Docker daemon socket path or URL
# DOCKER_HOST=unix:///var/run/docker.sock

# [OPTIONAL] Rust agent daemon identifier (default: edge-agent-01)
AGENT_ID=edge-agent-01

# [OPTIONAL] Rust agent region identifier (default: us-east-1)
AGENT_REGION=us-east-1

# [OPTIONAL] Rust agent control plane endpoint URL (default: https://api.edge-cloud.local)
CONTROL_PLANE_URL=https://api.edge-cloud.local

# [OPTIONAL] One-time bootstrap token for initial node enrollment
# BOOTSTRAP_TOKEN=your-node-enrollment-bootstrap-token

# [OPTIONAL] OpenTelemetry OTLP collector gRPC/HTTP endpoint (default: http://localhost:4317)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# [OPTIONAL] Rust tracing log filter level (default: info)
RUST_LOG=info

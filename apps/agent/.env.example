# Edge Agent - Environment Variables
# ==============================================================================

# --- Node Identity ---
NODE_ID=edge-node-001
NODE_NAME=Edge Node Alpha
NODE_LOCATION=Primary Data Center

# --- Core Settings ---
NODE_ENV=development
PORT=4001
LOG_LEVEL=info

# --- Networking ---
ORCHESTRATOR_URL=http://localhost:3090
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Security ---
JWT_SECRET=your-32-character-minimum-secret-key-goes-here
REQUEST_SIGNATURE_SECRET=your-hmac-signing-secret
API_KEY=
REQUIRE_API_KEY=false

# --- mTLS ---
ENABLE_MTLS=false
TLS_CERT_PATH=./certs/server.crt
TLS_KEY_PATH=./certs/server.key
TLS_CA_PATH=./certs/ca.crt

# --- Performance & Limits ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
IMAGE_ALLOWLIST_REGEX=^[^:]+(?::(?!latest)[a-zA-Z0-9._-]+)?$

# --- Infrastructure ---
DOCKER_HOST=

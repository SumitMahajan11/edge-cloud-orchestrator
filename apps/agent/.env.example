# Edge Agent - Environment Variables
# ==============================================================================
# This file defines the required and optional environment variables for the Edge Agent.
# Copy this to .env and adjust values for your environment.

# --- Node Identity ---
# NODE_ID: Unique identifier for this edge node. (REQUIRED, minimum 1 character).
NODE_ID=edge-node-001

# NODE_NAME: Human-readable name for this node. Defaults to Edge Node.
NODE_NAME=Edge Node Alpha

# NODE_LOCATION: Physical or logical location of the node. Defaults to Local.
NODE_LOCATION=Primary Data Center

# --- Core Settings ---
# NODE_ENV: Target environment (development, production, test). Defaults to development.
NODE_ENV=development

# PORT: Server port for the agent daemon to listen on. Defaults to 4001.
PORT=4001

# LOG_LEVEL: Application logging severity (fatal, error, warn, info, debug, trace). Defaults to info.
LOG_LEVEL=info

# --- Networking ---
# ORCHESTRATOR_URL: Target orchestrator API url (REQUIRED, must be a valid URL).
ORCHESTRATOR_URL=http://localhost:3090

# CORS_ORIGINS: Comma-separated origins allowed for CORS requests. Defaults to localhost origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Security & Auth ---
# JWT_SECRET: Secret key used to verify JSON Web Tokens signed by the Orchestrator. (REQUIRED, minimum 32 characters).
JWT_SECRET=your-32-character-minimum-secret-key-goes-here

# REQUEST_SIGNATURE_SECRET: Secret key used for signing request payloads between orchestrator and agent. (REQUIRED, minimum 1 character).
REQUEST_SIGNATURE_SECRET=your-hmac-signing-secret

# API_KEY: Optional local API key to restrict daemon API access (optional).
# API_KEY=

# REQUIRE_API_KEY: Enforce local API key authorization on all requests. Defaults to false.
REQUIRE_API_KEY=false

# --- mTLS Configuration ---
# ENABLE_MTLS: Enable mutual TLS authentication on local connections. Defaults to false.
ENABLE_MTLS=false

# TLS_CERT_PATH: Certificate file path. Defaults to ./certs/server.crt.
TLS_CERT_PATH=./certs/server.crt

# TLS_KEY_PATH: Private key file path. Defaults to ./certs/server.key.
TLS_KEY_PATH=./certs/server.key

# TLS_CA_PATH: CA certificate path. Defaults to ./certs/ca.crt.
TLS_CA_PATH=./certs/ca.crt

# --- Performance & Limits ---
# RATE_LIMIT_WINDOW_MS: Rate limiting window size in milliseconds. Defaults to 60000.
RATE_LIMIT_WINDOW_MS=60000

# RATE_LIMIT_MAX: Max requests per rate limiting window. Defaults to 100.
RATE_LIMIT_MAX=100

# IMAGE_ALLOWLIST_REGEX: Regex pattern restricting what Docker image names can be deployed on this node.
IMAGE_ALLOWLIST_REGEX=^[^:]+(?::(?!latest)[a-zA-Z0-9._-]+)?$

# --- Infrastructure ---
# DOCKER_HOST: Local/remote Docker daemon socket endpoint (optional, defaults to local socket).
# DOCKER_HOST=

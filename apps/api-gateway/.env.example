# ==============================================================================
# API Gateway (.env.example)
# ==============================================================================

# [OPTIONAL] Internal orchestrator API endpoint URL for upstream routing and CA cert discovery (default: http://api:3090)
API_URL=http://api:3090

# [OPTIONAL] Base64-encoded server SSL/TLS certificate in PEM format (leave empty to generate temporary self-signed cert)
# SSL_SERVER_CERT=LS0tLS1CRUdJTiBDRVJUSUZJQ0FURS0tLS0tCg==

# [OPTIONAL] Base64-encoded server SSL/TLS private key in PEM format (leave empty to generate temporary self-signed cert)
# SSL_SERVER_KEY=LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0tCg==

# [OPTIONAL] API Gateway public URL for validation and load test scripts (default: http://localhost:80)
GATEWAY_URL=http://localhost:80

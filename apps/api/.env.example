# ==============================================================================
# Edge-Cloud Orchestrator API (.env.example)
# ==============================================================================

# --- Core Server Settings ---
# [OPTIONAL] Runtime environment: development | production | test (default: development)
NODE_ENV=development

# [OPTIONAL] HTTP server port number (default: 3090)
PORT=3090

# [OPTIONAL] Network interface host binding (default: 0.0.0.0)
HOST=0.0.0.0

# [OPTIONAL] Application log severity: fatal | error | warn | info | debug | trace (default: info)
LOG_LEVEL=info

# [OPTIONAL] Console logging format: pretty | json (default: pretty)
LOG_FORMAT=pretty

# [OPTIONAL] Express/Fastify trust proxy setting behind reverse proxies (optional, e.g. true)
TRUST_PROXY=true

# --- Database Configuration ---
# [REQUIRED] Main PostgreSQL / CockroachDB connection string (Neon / Render / local placeholder)
DATABASE_URL=postgresql://user:password@ep-placeholder.region.aws.neon.tech/edgecloud?sslmode=require

# [OPTIONAL] Secondary read-replica database connection string
DATABASE_READ_URL=postgresql://user:password@ep-replica-placeholder.region.aws.neon.tech/edgecloud?sslmode=require

# [OPTIONAL] Direct database host address for microservice clients (default: localhost)
DATABASE_HOST=localhost

# [OPTIONAL] Direct database port number (default: 5432)
DATABASE_PORT=5432

# [OPTIONAL] Direct database name (default: edgecloud)
DATABASE_NAME=edgecloud

# [OPTIONAL] Direct database user name (default: edgecloud)
DATABASE_USER=edgecloud

# [OPTIONAL] Direct database password (safe placeholder)
DATABASE_PASSWORD=your_db_password_placeholder

# [OPTIONAL] Bypass SQL database and use in-memory mock repository: true | false (default: false)
FORCE_MOCK_DB=false

# --- Redis & Messaging ---
# [OPTIONAL] Redis / Upstash connection URL (safe placeholder, default: redis://localhost:6379)
REDIS_URL=rediss://default:your_upstash_redis_token_placeholder@placeholder.upstash.io:6379

# [OPTIONAL] Comma-separated Redis Sentinel server addresses (e.g. host1:26379,host2:26379)
# REDIS_SENTINELS=

# [OPTIONAL] Redis Sentinel master group name (default: mymaster)
REDIS_SENTINEL_NAME=mymaster

# [OPTIONAL] Authentication password for standalone Redis
# REDIS_PASSWORD=

# [OPTIONAL] Bypass Redis and use in-memory mock client: true | false (default: false)
FORCE_MOCK_REDIS=false

# [OPTIONAL] Comma-separated Kafka broker addresses (default: localhost:9092)
KAFKA_BROKERS=localhost:9092

# --- Authentication & Security ---
# [REQUIRED] Secret key for signing and verifying JWT tokens (min 32 chars)
JWT_SECRET=your-orchestrator-jwt-secret-min-32-chars-long-placeholder

# [OPTIONAL] Access token expiration duration (default: 15m)
JWT_EXPIRES_IN=15m

# [OPTIONAL] Refresh token expiration duration (default: 7d)
REFRESH_TOKEN_EXPIRES_IN=7d

# [OPTIONAL] JWT issuer claim verification string (default: edge-cloud-orchestrator)
JWT_ISSUER=edge-cloud-orchestrator

# [OPTIONAL] JWT audience claim verification string (default: edge-cloud-clients)
JWT_AUDIENCE=edge-cloud-clients

# [REQUIRED] 32-character encryption key for AES-256 field-level encryption
ENCRYPTION_KEY=your-aes256-encryption-key-min-32-chars-placeholder

# [OPTIONAL] Shared secret for edge agent HMAC signature verification (default: your-agent-signature-secret-minimum-32-chars)
REQUEST_SIGNATURE_SECRET=your-agent-signature-secret-minimum-32-chars

# [OPTIONAL] Service-to-service authentication token
SERVICE_TOKEN=your-service-token-minimum-32-chars

# --- Rate Limiting & Auth Policies ---
# [OPTIONAL] Maximum consecutive failed login attempts before lockout (default: 5)
MAX_LOGIN_ATTEMPTS=5

# [OPTIONAL] Account lockout duration in minutes after failed logins (default: 15)
LOCKOUT_DURATION_MINUTES=15

# [OPTIONAL] Rate limiting window duration in milliseconds (default: 60000)
RATE_LIMIT_WINDOW_MS=60000

# [OPTIONAL] Maximum requests allowed per rate limit window (default: 100)
RATE_LIMIT_MAX=100

# [OPTIONAL] Bypass rate limiting restrictions during automated test runs (default: false)
RATE_LIMIT_TEST_MODE=false

# --- Task Scheduling & Backpressure ---
# [OPTIONAL] Background scheduler poll interval in milliseconds (default: 2000)
SCHEDULER_POLL_INTERVAL_MS=2000

# [OPTIONAL] Periodic scheduling execution interval in milliseconds (default: 5000)
SCHEDULING_INTERVAL=5000

# [OPTIONAL] Maximum capacity of the task scheduler queue (default: 1000)
BP_MAX_QUEUE=1000

# [OPTIONAL] Maximum concurrent task executions managed by the scheduler (default: 100)
BP_MAX_CONCURRENT=100

# [OPTIONAL] Queue saturation fraction above which incoming tasks are dropped (default: 0.9)
BP_SHED_THRESHOLD=0.9

# [OPTIONAL] Queue saturation fraction above which throttling begins (default: 0.7)
BP_THROTTLE_THRESHOLD=0.7

# --- Networking & CORS ---
# [OPTIONAL] Comma-separated origins permitted by the CORS middleware
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-domain.vercel.app

# --- Monitoring, Tracing & Telemetry ---
# [OPTIONAL] Enable Prometheus /metrics endpoint exposition: true | false (default: true)
METRICS_ENABLED=true

# [OPTIONAL] Enable OpenTelemetry distributed tracing: true | false (default: false)
OTEL_ENABLED=false

# [OPTIONAL] Verbose OpenTelemetry SDK debugging output: true | false (default: false)
OTEL_DEBUG=false

# [OPTIONAL] Service identifier sent with OpenTelemetry traces (default: edge-cloud-orchestrator)
OTEL_SERVICE_NAME=edge-cloud-orchestrator

# [OPTIONAL] OpenTelemetry OTLP collector gRPC receiver endpoint (default: http://localhost:4317)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# [OPTIONAL] Jaeger HTTP traces ingestion endpoint (default: http://localhost:14268/api/traces)
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# [OPTIONAL] Jaeger agent UDP collector host (default: localhost)
JAEGER_AGENT_HOST=localhost

# [OPTIONAL] Jaeger agent UDP collector port (default: 6831)
JAEGER_AGENT_PORT=6831

# [OPTIONAL] Prometheus server query endpoint (default: http://prometheus:9090)
PROMETHEUS_URL=http://prometheus:9090

# --- mTLS Configuration ---
# [OPTIONAL] Enforce mutual TLS authentication on edge agent endpoints: true | false (default: false)
MTLS_ENABLED=false

# [OPTIONAL] File system path to the API server certificate (default: /etc/edgecloud/server.crt)
MTLS_SERVER_CERT=/etc/edgecloud/server.crt

# [OPTIONAL] File system path to the API server private key (default: /etc/edgecloud/server.key)
MTLS_SERVER_KEY=/etc/edgecloud/server.key

# [OPTIONAL] File system path to the trusted CA root certificate
# MTLS_CA_CERT=/etc/edgecloud/ca.crt

# [OPTIONAL] Trust client certificate passed in X-Client-Cert reverse proxy header (default: false)
TRUST_X_CLIENT_CERT=false

# [OPTIONAL] Custom header delimiter for PEM certificate parsing
# PEM_CERT_HEADER=

# [OPTIONAL] Custom footer delimiter for PEM certificate parsing
# PEM_CERT_FOOTER=

# --- External Cloud & Integrations ---
# [OPTIONAL] GitHub personal access token for release updates
# GITHUB_TOKEN=ghp_your_github_token_placeholder

# [OPTIONAL] GitHub repository owner account name
# GITHUB_REPO_OWNER=your-org

# [OPTIONAL] GitHub repository name
# GITHUB_REPO_NAME=edge-cloud-orchestrator

# [OPTIONAL] Outbound webhook URL for operational incident alerts
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/placeholder

# [OPTIONAL] Alert throttle rate limit period in milliseconds (default: 60000)
ALERT_THROTTLE_MS=60000

# [OPTIONAL] ElectricityMaps API authentication key for live grid carbon intensity tracking
# ELECTRICITY_MAPS_API_KEY=your_electricity_maps_api_key_placeholder

# [OPTIONAL] Carbon intensity weighting coefficient in scheduling decisions (default: 0.2)
CARBON_WEIGHT=0.2

# --- Object Storage (S3 / MinIO) ---
# [OPTIONAL] AWS region name for S3 bucket operations (default: us-east-1)
AWS_REGION=us-east-1

# [OPTIONAL] AWS / MinIO access key ID
AWS_ACCESS_KEY_ID=minioadmin

# [OPTIONAL] AWS / MinIO secret access key
AWS_SECRET_ACCESS_KEY=minioadmin

# [OPTIONAL] Custom S3 API endpoint URL (e.g. MinIO http://localhost:9000)
# S3_ENDPOINT=http://localhost:9000

# [OPTIONAL] S3 bucket designated for machine learning model artifacts (default: edge-cloud-models)
MODEL_STORAGE_BUCKET=edge-cloud-models

# [OPTIONAL] S3 bucket designated for consistency and audit reports (default: edgecloud-reports)
REPORTS_BUCKET=edgecloud-reports

# --- Application & Infrastructure ---
# [OPTIONAL] Semantic version string of the orchestrator API (default: 4.0.0)
APP_VERSION=4.0.0

# [OPTIONAL] Local path to Kubernetes cluster config file (defaults to in-cluster config)
# KUBECONFIG=~/.kube/config

# [OPTIONAL] Minimum semver version required for compatible ML models (default: 1.0.0)
ML_MODEL_MIN_VERSION=1.0.0

# [OPTIONAL] Alias filter for minimum model version
# MIN_MODEL_VERSION=1.0.0

# [OPTIONAL] Minimum number of execution outcomes logged before triggering ML model retrain (default: 100)
MIN_OUTCOMES_FOR_RETRAIN=100

# [OPTIONAL] Simulate ML training without executing XGBoost/Python processes (default: false)
MOCK_ML_TRAINING=false

# [OPTIONAL] Maximum number of sample evaluations to run in shadow scheduling mode (default: 100)
SHADOW_EVAL_LIMIT=100

# --- AutoHealer Configuration ---
# [OPTIONAL] Cooldown duration in milliseconds between triggered healing actions (default: 60000)
HEALER_COOLDOWN_MS=60000

# [OPTIONAL] Maximum concurrent active healing routines (default: 5)
HEALER_MAX_CONCURRENT=5

# [OPTIONAL] Permit autohealer to invoke Kubernetes pod restarts: true | false (default: true)
HEALER_K8S_ENABLED=true

# [OPTIONAL] Target Kubernetes namespace for node healing operations (default: default)
HEALER_K8S_NAMESPACE=default

# --- Secret Management Backend ---
# [OPTIONAL] HashiCorp Vault server connection URL
# VAULT_ADDR=http://localhost:8200

# [OPTIONAL] HashiCorp Vault authentication token
# VAULT_TOKEN=your-vault-token-placeholder

# [OPTIONAL] HashiCorp Vault kv engine mount path (default: secret)
VAULT_MOUNT_PATH=secret

# [OPTIONAL] Directory containing mounted Kubernetes secret files (default: /etc/edgecloud/secrets)
K8S_SECRETS_DIR=/etc/edgecloud/secrets

# [OPTIONAL] Secret manager backend provider: env | vault | k8s (default: env)
SECRET_BACKEND=env

# [OPTIONAL] Allow webhook outbound requests to private RFC-1918 IP addresses (default: false)
ALLOW_PRIVATE_IPS=false

# --- Seed Users & Demo Data ---
# [OPTIONAL] Default administrative user email seeded during initial database setup (default: admin@edge-cloud.io)
SEED_ADMIN_EMAIL=admin@edge-cloud.io

# [OPTIONAL] Default operator user email seeded during initial setup (default: operator@edge-cloud.io)
SEED_OPERATOR_EMAIL=operator@edge-cloud.io

# [OPTIONAL] Default viewer user email seeded during initial setup (default: viewer@edge-cloud.io)
SEED_VIEWER_EMAIL=viewer@edge-cloud.io

# [OPTIONAL] Custom seed password for the admin account
# SEED_ADMIN_PASSWORD=

# [OPTIONAL] Custom seed password for the operator account
# SEED_OPERATOR_PASSWORD=

# [OPTIONAL] Custom seed password for the viewer account
# SEED_VIEWER_PASSWORD=

# [OPTIONAL] Legacy admin account password override
# ADMIN_PASSWORD=

# [OPTIONAL] Legacy operator account password override
# OPERATOR_PASSWORD=

# [OPTIONAL] Legacy viewer account password override
# VIEWER_PASSWORD=

# [OPTIONAL] Enable pre-seeded demo user credentials in development: true | false (default: false)
ENABLE_DEMO_CREDENTIALS=false

# [OPTIONAL] Automatically spin up background simulated demo agents: true | false (default: false)
ENABLE_DEMO_AGENT=false

# --- Code Generation & Test Harness ---
# [OPTIONAL] Generate OpenAPI v2/v3 YAML specification on startup: true | false (default: false)
GEN_OPENAPI=false

# [OPTIONAL] Terminate process immediately after exporting OpenAPI specification: true | false (default: false)
EXIT_AFTER_GEN=false

# [OPTIONAL] Integration test runner indicator
VITEST=

# [OPTIONAL] Base API URL used by diagnostic and chaos test scripts (default: http://localhost:3090)
API_URL=http://localhost:3090

# [OPTIONAL] Docker container name for database during chaos testing (default: edgecloud-postgres)
DB_CONTAINER=edgecloud-postgres

# [OPTIONAL] Docker container name for Redis during chaos testing (default: edgecloud-redis)
REDIS_CONTAINER=edgecloud-redis

# [OPTIONAL] Enable Docker container disruption in chaos test suite: true | false (default: false)
RUN_DOCKER_CHAOS=false

# [OPTIONAL] Remote Neon PostgreSQL connection URL for database migration script
# NEON_DATABASE_URL=postgresql://user:password@ep-placeholder.region.aws.neon.tech/edgecloud?sslmode=require

# [OPTIONAL] Remote Supabase PostgreSQL connection URL for database migration script
# SUPABASE_DATABASE_URL=postgresql://postgres:password@db.placeholder.supabase.co:5432/postgres

# --- Data Retention Policies ---
# [OPTIONAL] Number of days to retain system metric records: 1 to 90 (default: 7)
METRIC_RETENTION_DAYS=7

# [OPTIONAL] Maximum outcome log rows retained for model training: 1000 to 1000000 (default: 100000)
ML_OUTCOME_RETENTION=100000

# Edge-Cloud Orchestrator API - Environment Variables
# ==============================================================================
# This file defines the required and optional environment variables for the API.
# Copy this to .env and adjust values for your environment.

# --- Core Settings ---
# NODE_ENV: Target environment (development, production, test). Defaults to development.
NODE_ENV=development

# PORT: Server port. Must be an integer between 1024 and 65535. Defaults to 3090.
PORT=3090

# HOST: Network host address to bind the server. Defaults to 0.0.0.0.
HOST=0.0.0.0

# LOG_LEVEL: Application logging severity (fatal, error, warn, info, debug, trace). Defaults to info.
LOG_LEVEL=info

# LOG_FORMAT: Console log styling (pretty, json). Defaults to pretty.
LOG_FORMAT=pretty

# TRUST_PROXY: Trust proxy headers (e.g. when behind Nginx/Cloudflare) (optional).
# TRUST_PROXY=true

# --- Database ---
# DATABASE_URL: Main PostgreSQL database connection URL. (REQUIRED, must be a valid URL).
DATABASE_URL=postgresql://root@localhost:26257/edgecloud?sslmode=disable

# DATABASE_READ_URL: Optional read-replica PostgreSQL connection URL (optional).
DATABASE_READ_URL=

# FORCE_MOCK_DB: Run application with in-memory database mocks instead of SQL database. Defaults to false.
FORCE_MOCK_DB=false

# --- Messaging & Redis ---
# REDIS_URL: Redis connection URL (optional).
REDIS_URL=redis://localhost:6379

# REDIS_SENTINELS: Comma-separated list of Sentinel addresses (optional, e.g. "localhost:26379,localhost:26380").
REDIS_SENTINELS=

# REDIS_SENTINEL_NAME: Name of the Redis Sentinel master group. Defaults to mymaster.
REDIS_SENTINEL_NAME=mymaster

# REDIS_PASSWORD: Password for Redis connection (optional).
# REDIS_PASSWORD=

# FORCE_MOCK_REDIS: Run application with in-memory Redis mocks. Defaults to false.
FORCE_MOCK_REDIS=false

# KAFKA_BROKERS: Comma-separated list of Kafka broker endpoints. Defaults to localhost:9092.
KAFKA_BROKERS=localhost:9092

# --- Security & JWT ---
# JWT_SECRET: Secret key used to sign JSON Web Tokens. (REQUIRED, minimum 32 characters).
JWT_SECRET=your-32-character-minimum-secret-key-goes-here

# JWT_EXPIRES_IN: Token expiration duration (e.g. 15m, 1h). Defaults to 15m.
JWT_EXPIRES_IN=15m

# REFRESH_TOKEN_EXPIRES_IN: Refresh token expiration duration (e.g. 7d, 30d). Defaults to 7d.
REFRESH_TOKEN_EXPIRES_IN=7d

# JWT_ISSUER: Token issuer claim. Defaults to edge-cloud-orchestrator.
JWT_ISSUER=edge-cloud-orchestrator

# JWT_AUDIENCE: Token audience claim. Defaults to edge-cloud-clients.
JWT_AUDIENCE=edge-cloud-clients

# ENCRYPTION_KEY: Secret key used for field-level database encryption. (REQUIRED, minimum 32 characters).
ENCRYPTION_KEY=another-32-character-encryption-key-for-data

# --- Auth Policy ---
# MAX_LOGIN_ATTEMPTS: Max failed login attempts before lockout. Defaults to 5.
MAX_LOGIN_ATTEMPTS=5

# LOCKOUT_DURATION_MINUTES: Lockout duration in minutes for exceeded logins. Defaults to 15.
LOCKOUT_DURATION_MINUTES=15

# RATE_LIMIT_WINDOW_MS: Rate limit sliding window size in milliseconds. Defaults to 60000.
RATE_LIMIT_WINDOW_MS=60000

# --- Networking ---
# ALLOWED_ORIGINS: Comma-separated origins allowed for CORS requests. Defaults to localhost origins.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Telemetry ---
# METRICS_ENABLED: Enable Prometheus metrics endpoint collection. Defaults to true.
METRICS_ENABLED=true

# OTEL_ENABLED: Enable OpenTelemetry tracer agent. Defaults to false.
OTEL_ENABLED=false

# OTEL_DEBUG: Verbose OpenTelemetry debugging output. Defaults to false.
OTEL_DEBUG=false

# OTEL_SERVICE_NAME: Service name reported to tracer. Defaults to edge-cloud-orchestrator.
OTEL_SERVICE_NAME=edge-cloud-orchestrator

# OTEL_EXPORTER_OTLP_ENDPOINT: OTLP collector gRPC receiver endpoint. Defaults to http://localhost:4317.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# JAEGER_ENDPOINT: Jaeger tracing server endpoint. Defaults to http://localhost:14268/api/traces.
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# --- mTLS (Production Only) ---
# MTLS_ENABLED: Enforce mutual TLS authentication on API endpoints. Defaults to false.
MTLS_ENABLED=false

# MTLS_SERVER_CERT: Server certificate path. Defaults to /etc/edgecloud/server.crt.
MTLS_SERVER_CERT=/etc/edgecloud/server.crt

# MTLS_SERVER_KEY: Server private key path. Defaults to /etc/edgecloud/server.key.
MTLS_SERVER_KEY=/etc/edgecloud/server.key

# MTLS_CA_CERT: Certificate Authority (CA) root cert file path (optional).
MTLS_CA_CERT=

# --- Git Integration ---
# GITHUB_TOKEN: GitHub personal access token for pulling model updates (optional).
# GITHUB_TOKEN=

# GITHUB_REPO_OWNER: GitHub repository owner for model releases (optional).
# GITHUB_REPO_OWNER=

# GITHUB_REPO_NAME: GitHub repository name for model releases (optional).
# GITHUB_REPO_NAME=

# --- Alerting & Webhooks ---
# ALERT_WEBHOOK_URL: Webhook URL to POST system alerts/notifications (optional).
# ALERT_WEBHOOK_URL=

# ALERT_THROTTLE_MS: Time duration in ms to throttle duplicate webhook alerts. Defaults to 60000.
ALERT_THROTTLE_MS=60000

# --- Carbon & Electricity Integrations ---
# ELECTRICITY_MAPS_API_KEY: API key for accessing ElectricityMaps API (optional).
# ELECTRICITY_MAPS_API_KEY=

# CARBON_WEIGHT: Weighted carbon index multiplier. Defaults to 0.2.
CARBON_WEIGHT=0.2

# --- AWS / S3 Storage ---
# AWS_REGION: Target AWS deployment region. Defaults to us-east-1.
AWS_REGION=us-east-1

# AWS_ACCESS_KEY_ID: AWS access credentials for S3 operations (optional).
# AWS_ACCESS_KEY_ID=

# AWS_SECRET_ACCESS_KEY: AWS secret credentials for S3 operations (optional).
# AWS_SECRET_ACCESS_KEY=

# S3_ENDPOINT: Custom S3 storage URL (e.g. MinIO or LocalStack) (optional).
# S3_ENDPOINT=

# MODEL_STORAGE_BUCKET: S3 bucket name where ML models are stored. Defaults to edge-cloud-models.
MODEL_STORAGE_BUCKET=edge-cloud-models

# REPORTS_BUCKET: S3 bucket name where generated PDF/JSON reports are stored. Defaults to edgecloud-reports.
REPORTS_BUCKET=edgecloud-reports

# --- Orchestrator Logic ---
# SCHEDULING_INTERVAL: Interval in ms between scheduling iterations. Defaults to 5000.
SCHEDULING_INTERVAL=5000

# APP_VERSION: Configured orchestrator application version. Defaults to 4.0.0.
APP_VERSION=4.0.0

# KUBECONFIG: Absolute path to Kubernetes config file (optional, defaults to standard in-cluster config if empty).
# KUBECONFIG=

# ML_MODEL_MIN_VERSION: Hard minimum semver requirement for models. Defaults to 1.0.0.
ML_MODEL_MIN_VERSION=1.0.0

# MIN_MODEL_VERSION: Optional minimum version filter for models (optional).
# MIN_MODEL_VERSION=

# --- AutoHealer Configuration ---
# HEALER_COOLDOWN_MS: Cooldown period in ms between triggered auto-heal actions. Defaults to 60000.
HEALER_COOLDOWN_MS=60000

# HEALER_MAX_CONCURRENT: Maximum concurrent auto-heal actions. Defaults to 5.
HEALER_MAX_CONCURRENT=5

# HEALER_K8S_ENABLED: Enable auto-heal actions against Kubernetes orchestrator resources. Defaults to true.
HEALER_K8S_ENABLED=true

# HEALER_K8S_NAMESPACE: Targeted Kubernetes namespace for healer actions. Defaults to default.
HEALER_K8S_NAMESPACE=default

# --- Monitoring ---
# PROMETHEUS_URL: API endpoint URL of Prometheus monitoring server. Defaults to http://prometheus:9090.
PROMETHEUS_URL=http://prometheus:9090

# --- Backpressure Configuration ---
# BP_MAX_QUEUE: Maximum size of scheduling tasks queue. Defaults to 1000.
BP_MAX_QUEUE=1000

# BP_MAX_CONCURRENT: Maximum concurrent scheduling jobs. Defaults to 100.
BP_MAX_CONCURRENT=100

# BP_SHED_THRESHOLD: Queue saturation threshold (0.0 to 1.0) above which new tasks are shed. Defaults to 0.9.
BP_SHED_THRESHOLD=0.9

# BP_THROTTLE_THRESHOLD: Queue saturation threshold (0.0 to 1.0) above which throttling triggers. Defaults to 0.7.
BP_THROTTLE_THRESHOLD=0.7

# --- CLI & Code Gen Utility ---
# GEN_OPENAPI: Generate OpenAPI documentation format at startup. Defaults to false.
GEN_OPENAPI=false

# EXIT_AFTER_GEN: Terminate application immediately after writing OpenAPI schema. Defaults to false.
EXIT_AFTER_GEN=false

# --- Seed User / Demo Configurations ---
# SEED_ADMIN_EMAIL: Email address of default administrator seeded at database initialization. Defaults to admin@edge-cloud.io.
SEED_ADMIN_EMAIL=admin@edge-cloud.io

# SEED_OPERATOR_EMAIL: Email address of default operator seeded at database initialization. Defaults to operator@edge-cloud.io.
SEED_OPERATOR_EMAIL=operator@edge-cloud.io

# SEED_VIEWER_EMAIL: Email address of default viewer seeded at database initialization. Defaults to viewer@edge-cloud.io.
SEED_VIEWER_EMAIL=viewer@edge-cloud.io

# SEED_ADMIN_PASSWORD / SEED_OPERATOR_PASSWORD / SEED_VIEWER_PASSWORD: Custom seed user passwords (optional).
# SEED_ADMIN_PASSWORD=
# SEED_OPERATOR_PASSWORD=
# SEED_VIEWER_PASSWORD=

# ENABLE_DEMO_CREDENTIALS: Enable login bypass with default demo credentials. Defaults to false.
ENABLE_DEMO_CREDENTIALS=false

# --- Testing Configuration ---
# RUN_INTEGRATION_TESTS: Enable active database and redis integrations verification in tests. Defaults to false.
RUN_INTEGRATION_TESTS=false

# --- Data Retention Policies ---
# METRIC_RETENTION_DAYS: Retention policy in days for telemetry logs. Must be between 1 and 90. Defaults to 7.
METRIC_RETENTION_DAYS=7

# ML_OUTCOME_RETENTION: Number of historical ML outcome records to retain. Must be between 1000 and 1,000,000. Defaults to 100000.
ML_OUTCOME_RETENTION=100000

# Edge-Cloud Orchestrator API - Environment Variables
# ==============================================================================
# This file defines the required and optional environment variables for the API.
# Copy this to .env and adjust values for your environment.

# --- Core Settings ---
NODE_ENV=development
PORT=3090
HOST=0.0.0.0
LOG_LEVEL=info
LOG_FORMAT=pretty

# --- Database ---
DATABASE_URL=postgresql://root@localhost:26257/edgecloud?sslmode=disable
DATABASE_READ_URL=
FORCE_MOCK_DB=false

# --- Messaging & Redis ---
REDIS_URL=redis://localhost:6379
REDIS_SENTINELS=
FORCE_MOCK_REDIS=false
KAFKA_BROKERS=localhost:9092

# --- Security ---
JWT_SECRET=your-32-character-minimum-secret-key-goes-here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
ENCRYPTION_KEY=another-32-character-encryption-key-for-data

# --- Auth Policy ---
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
RATE_LIMIT_WINDOW_MS=60000

# --- Networking ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Telemetry ---
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_DEBUG=false
OTEL_SERVICE_NAME=edge-cloud-orchestrator
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# --- mTLS (Production Only) ---
MTLS_ENABLED=false
MTLS_SERVER_CERT=/etc/edgecloud/server.crt
MTLS_SERVER_KEY=/etc/edgecloud/server.key
MTLS_CA_CERT=

# --- Orchestrator Logic ---
SCHEDULING_INTERVAL=5000
APP_VERSION=4.0.0
ML_MODEL_MIN_VERSION=1.0.0

# --- Secret Management Backend ---
SECRET_BACKEND=env
VAULT_ADDR=
VAULT_TOKEN=

# --- Seed Data ---
SEED_ADMIN_EMAIL=admin@edge-cloud.io
SEED_OPERATOR_EMAIL=operator@edge-cloud.io
SEED_VIEWER_EMAIL=viewer@edge-cloud.io
ENABLE_DEMO_CREDENTIALS=false

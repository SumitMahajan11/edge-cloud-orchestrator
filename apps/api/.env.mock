# ============================================
# Edge-Cloud Orchestrator - Development Environment
# ============================================
# Infrastructure-free dev mode: mock DB and Redis enabled.
# DO NOT commit real secrets.

# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=3090
HOST=0.0.0.0
LOG_LEVEL=info
LOG_FORMAT=pretty

# ============================================
# CRITICAL SECURITY SETTINGS
# ============================================

# JWT Secret - MUST be at least 32 characters
JWT_SECRET=dev-super-secret-jwt-key-minimum-32-characters-long-2026

# Encryption Key - MUST be at least 32 characters for AES-256
ENCRYPTION_KEY=dev-encryption-key-minimum-32-characters-long-2026!!

# Service Token for inter-service communication
SERVICE_TOKEN=dev-service-token-minimum-32-characters-long-2026!!

# JWT claims (defaults built into env.ts but explicit is clearer)
JWT_ISSUER=edge-cloud-orchestrator
JWT_AUDIENCE=edge-cloud-clients
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ============================================
# Database Configuration
# ============================================
# Real DB connection (unused in mock mode below)
DATABASE_URL=postgresql://edgecloud:edgecloud123@127.0.0.1:5432/edgecloud
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=edgecloud
DATABASE_USER=edgecloud
DATABASE_PASSWORD=edgecloud123

# ── KEY FIX: use in-memory mock so the server starts without Postgres ──────
FORCE_MOCK_DB=true
FORCE_MOCK_REDIS=true

# ============================================
# Redis Configuration (ignored when FORCE_MOCK_REDIS=true)
# ============================================
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# Kafka Configuration
# ============================================
KAFKA_BROKERS=localhost:9092

# ============================================
# CORS Configuration
# ── KEY FIX: schema reads ALLOWED_ORIGINS, not CORS_ORIGINS ──────────────
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:3000

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000
MAX_LOGIN_ATTEMPTS=10
LOCKOUT_DURATION_MINUTES=15

# ============================================
# mTLS Configuration
# ============================================
MTLS_ENABLED=false

# ============================================
# Vault Configuration (disabled in dev)
# ============================================
SECRET_BACKEND=env

# ============================================
# Telemetry
# ============================================
METRICS_ENABLED=true
OTEL_ENABLED=false

# ============================================
# Scheduler
# ============================================
SCHEDULING_INTERVAL=5000
APP_VERSION=4.2.0

NODE_ENV=development
PORT=3091
HOST=0.0.0.0

# Real Postgres (port 5433 = our Docker container)
DATABASE_URL=postgresql://<username>:<password>@localhost:5433/<dbname>

# Real Redis (port 6380 = our Docker container)
REDIS_URL=redis://localhost:6380

# JWT — must be 32+ chars, no weak substrings (no 'secret', 'test', 'demo', 'password')
JWT_SECRET=your_jwt_secret_must_be_32_chars_or_more_and_secure
JWT_REFRESH_SECRET=your_jwt_refresh_secret_must_be_32_chars_or_more_and_secure
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=7d

# Encryption
ENCRYPTION_KEY=your_encryption_key_must_be_32_chars_long
SERVICE_TOKEN=your_service_token_must_be_32_chars_long

# Disable mocks explicitly
FORCE_MOCK_DB=false
FORCE_MOCK_REDIS=false

# Carbon API
ELECTRICITY_MAPS_API_KEY=

# Observability
OTEL_ENABLED=false
METRICS_ENABLED=true

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:3000
CORS_ORIGIN=http://localhost:3000

# Log level
LOG_LEVEL=info

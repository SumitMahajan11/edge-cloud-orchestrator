{
  "name": "@edgecloud/api",
  "version": "1.0.0",
  "description": "Production backend for Edge-Cloud Compute Orchestrator",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "cross-env PORT=3090 tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "generate": "prisma generate",
    "seed": "tsx src/database/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts --max-warnings=9999",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "gen:openapi": "cross-env GEN_OPENAPI=true EXIT_AFTER_GEN=true FORCE_MOCK_REDIS=true FORCE_MOCK_DB=true DATABASE_URL=postgresql://dummy:5432/db JWT_SECRET=dummy_secret_at_least_32_characters_long_for_generation ENCRYPTION_KEY=dummy_key_at_least_32_characters_long_for_generation tsx src/index.ts",
    "gen:sdk": "openapi-ts",
    "gen:docs": "redoc-cli build openapi-v2.yml --output ../../docs/api-reference.html",
    "gen:postman": "npx openapi-to-postmanv2 -s openapi-v2.yml -o ../../docs/postman-collection.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1038.0",
    "@edgecloud/circuit-breaker": "workspace:*",
    "@edgecloud/ml-scheduler": "workspace:*",
    "@edgecloud/observability": "workspace:*",
    "@edgecloud/saga": "workspace:*",
    "@edgecloud/scheduling-utils": "workspace:*",
    "@edgecloud/shared-kernel": "workspace:*",
    "@fastify/cookie": "^9.2.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.0",
    "@fastify/multipart": "^7.7.3",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.0",
    "@fastify/swagger-ui": "^4.0.0",
    "@kubernetes/client-node": "^1.4.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.71.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.213.0",
    "@opentelemetry/instrumentation-fastify": "^0.57.0",
    "@opentelemetry/instrumentation-http": "^0.213.0",
    "@opentelemetry/instrumentation-pg": "^0.65.0",
    "@opentelemetry/instrumentation-redis": "^0.61.0",
    "@opentelemetry/sdk-node": "^0.213.0",
    "@opentelemetry/sdk-trace-base": "^2.6.0",
    "@peculiar/x509": "^2.0.0",
    "@prisma/client": "^5.22.0",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "eventemitter3": "^5.0.0",
    "fastify": "^4.29.1",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "prom-client": "^15.1.3",
    "range_check": "^4.1.0",
    "redlock": "5.0.0-beta.2",
    "reflect-metadata": "^0.2.2",
    "uuid": "^9.0.1",
    "ws": "^8.21.3",
    "yaml": "^2.8.3",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.23.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/websocket": "^8.3.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.97.0",
    "@types/amqplib": "^0.10.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.37",
    "@types/redlock": "^4.0.3",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "nock": "^14.0.16",
    "openapi-fetch": "^0.17.0",
    "openapi-to-postmanv2": "^6.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "prisma": "^5.22.0",
    "redoc-cli": "^0.13.21",
    "tsx": "^4.11.2",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

# ==============================================================================
# Metrics Service (.env.example)
# ==============================================================================

# [OPTIONAL] Runtime environment: development | production | test (default: development)
NODE_ENV=development

# [OPTIONAL] Local HTTP server port for metrics aggregation (default: 3005)
PORT=3005

# [OPTIONAL] Application log severity: fatal | error | warn | info | debug | trace (default: info)
LOG_LEVEL=info

# [REQUIRED] Shared JWT secret for validating inter-service auth headers (min 32 chars)
JWT_SECRET=your-metrics-jwt-secret-min-32-chars-long-placeholder

# [OPTIONAL] Internal API monolith endpoint URL for scraping metrics (default: http://api:3000)
API_URL=http://api:3000

# [OPTIONAL] Task service endpoint URL for scraping queue stats (default: http://task-service:3001)
TASK_SERVICE_URL=http://task-service:3001

# [OPTIONAL] Node service endpoint URL for querying online node count (default: http://node-service:3002)
NODE_SERVICE_URL=http://node-service:3002

# [OPTIONAL] Scheduler service endpoint URL for scraping scheduling latency (default: http://scheduler-service:3003)
SCHEDULER_SERVICE_URL=http://scheduler-service:3003

# [OPTIONAL] WebSocket gateway endpoint URL for connection telemetry (default: http://websocket-gateway:3004)
WEBSOCKET_GATEWAY_URL=http://websocket-gateway:3004

# [OPTIONAL] Redis connection URL for reading consumer stream lag (default: redis://localhost:6379)
REDIS_URL=redis://localhost:6379

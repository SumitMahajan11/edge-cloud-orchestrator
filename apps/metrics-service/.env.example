# Metrics Service - Environment Variables
# ==============================================================================

NODE_ENV=development
PORT=3005
LOG_LEVEL=info

# --- Service Discovery ---
API_URL=http://api:3000
TASK_SERVICE_URL=http://task-service:3001
NODE_SERVICE_URL=http://node-service:3002
SCHEDULER_SERVICE_URL=http://scheduler-service:3003
WEBSOCKET_GATEWAY_URL=http://websocket-gateway:3004

# --- Messaging ---
REDIS_URL=redis://localhost:6379

# --- Internal Auth ---
JWT_SECRET=your-32-character-minimum-secret-key-goes-here

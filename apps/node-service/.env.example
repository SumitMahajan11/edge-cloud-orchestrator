# ==============================================================================
# Node Service (.env.example)
# ==============================================================================

# [OPTIONAL] Runtime environment: development | production | test (default: development)
NODE_ENV=development

# [OPTIONAL] Local HTTP server port for node service (default: 3002)
PORT=3002

# [OPTIONAL] Application log severity: fatal | error | warn | info | debug | trace (default: info)
LOG_LEVEL=info

# [REQUIRED] Shared JWT secret for validating authentication tokens (min 32 chars)
JWT_SECRET=your-node-service-jwt-secret-min-32-chars-long-placeholder

# [OPTIONAL] PostgreSQL / CockroachDB connection string (optional override)
# DATABASE_URL=postgresql://root:password@localhost:26257/edgecloud?sslmode=disable

# [OPTIONAL] Direct database host address (default: localhost)
DATABASE_HOST=localhost

# [OPTIONAL] Direct database port number (default: 26257)
DATABASE_PORT=26257

# [OPTIONAL] Direct database name (default: edgecloud)
DATABASE_NAME=edgecloud

# [OPTIONAL] Direct database user name (default: root)
DATABASE_USER=root

# [OPTIONAL] Direct database password (safe placeholder)
DATABASE_PASSWORD=your_db_password_placeholder

# [OPTIONAL] Redis connection URL (default: redis://localhost:6379)
REDIS_URL=redis://localhost:6379

# [OPTIONAL] Comma-separated list of Redis Sentinel addresses
# REDIS_SENTINELS=

# [OPTIONAL] Comma-separated list of Kafka brokers (default: localhost:9092)
KAFKA_BROKERS=localhost:9092

# [OPTIONAL] Service-to-service authentication token (default: dev-service-token)
SERVICE_TOKEN=dev-service-token-placeholder

# [OPTIONAL] Permitted origins for Cross-Origin Resource Sharing (default: *)
CORS_ORIGINS=*

# [OPTIONAL] ISO timestamp embedded during Docker image build
# BUILD_DATE=

# [OPTIONAL] Git commit SHA embedded during Docker image build
# GIT_SHA=

# Task Service - Environment Variables
# ==============================================================================

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# --- Database ---
DATABASE_HOST=localhost
DATABASE_PORT=26257
DATABASE_NAME=edgecloud
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_SSL=false

# --- Messaging ---
REDIS_URL=redis://localhost:6379
REDIS_SENTINELS=
KAFKA_BROKERS=localhost:9092

# --- Internal Auth ---
JWT_SECRET=your-32-character-minimum-secret-key-goes-here
SERVICE_TOKEN=dev-service-token

# --- Networking ---
CORS_ORIGINS=*

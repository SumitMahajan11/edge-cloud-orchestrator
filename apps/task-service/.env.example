# ==============================================================================
# Task Service (.env.example)
# ==============================================================================

# [OPTIONAL] Runtime environment: development | production | test (default: development)
NODE_ENV=development

# [OPTIONAL] Local HTTP server port for task service (default: 3001)
PORT=3001

# [OPTIONAL] Application log severity: fatal | error | warn | info | debug | trace (default: info)
LOG_LEVEL=info

# [REQUIRED] Shared JWT secret for validating authentication tokens (min 32 chars)
JWT_SECRET=your-task-service-jwt-secret-min-32-chars-long-placeholder

# [REQUIRED] Database host address (e.g. localhost or database service hostname)
DATABASE_HOST=localhost

# [OPTIONAL] Database port number (default: 26257)
DATABASE_PORT=26257

# [OPTIONAL] Database name (default: edgecloud)
DATABASE_NAME=edgecloud

# [OPTIONAL] Database user name (default: root)
DATABASE_USER=root

# [OPTIONAL] Database password (safe placeholder)
DATABASE_PASSWORD=your_db_password_placeholder

# [OPTIONAL] Enforce SSL connection to the database: true | false (default: false)
DATABASE_SSL=false

# [OPTIONAL] Redis connection URL (default: redis://localhost:6379)
REDIS_URL=redis://localhost:6379

# [OPTIONAL] Comma-separated list of Redis Sentinel addresses
# REDIS_SENTINELS=

# [OPTIONAL] Comma-separated list of Kafka brokers (default: localhost:9092)
KAFKA_BROKERS=localhost:9092

# [OPTIONAL] Service-to-service authentication token (default: dev-service-token)
SERVICE_TOKEN=dev-service-token-placeholder

# [OPTIONAL] Permitted origins for Cross-Origin Resource Sharing (default: *)
CORS_ORIGINS=*

# ==============================================================================
# Web Dashboard Frontend (.env.example)
# ==============================================================================

# [OPTIONAL] Runtime environment: development | production | test (default: development)
NODE_ENV=development

# [OPTIONAL] Public HTTP/HTTPS endpoint URL for Orchestrator API Gateway (default: http://localhost:3090)
NEXT_PUBLIC_API_URL=http://localhost:3090

# [OPTIONAL] Public WebSocket endpoint URL for live dashboard updates (default: ws://localhost:3090/ws)
NEXT_PUBLIC_WS_URL=ws://localhost:3090/ws

# [OPTIONAL] Enable verbose OpenTelemetry telemetry debugging in browser: true | false (default: false)
NEXT_PUBLIC_OTEL_DEBUG=false

# [OPTIONAL] Alternative toggle for OpenTelemetry collector debugging output: true | false (default: false)
NEXT_PUBLIC_OTLP_DEBUG=false

# [OPTIONAL] OpenTelemetry OTLP web tracer HTTP export endpoint (e.g. http://localhost:4318/v1/traces)
NEXT_PUBLIC_OTLP_ENDPOINT=http://localhost:4318/v1/traces

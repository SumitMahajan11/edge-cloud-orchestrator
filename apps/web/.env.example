# Edge-Cloud Orchestrator Web App - Environment Variables
# Copy this file to .env.local for local development.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# --- API and WebSocket endpoints ---
# Base URL for the Edge-Cloud API.
NEXT_PUBLIC_API_URL=http://localhost:3090

# WebSocket endpoint used for live node and task updates.
NEXT_PUBLIC_WS_URL=ws://localhost:3090/ws

# --- Browser tracing (optional) ---
# OTLP HTTP endpoint for browser traces. Leave empty to disable export locally.
NEXT_PUBLIC_OTLP_ENDPOINT=

# Enable verbose OpenTelemetry diagnostics in the browser.
NEXT_PUBLIC_OTEL_DEBUG=false

# Legacy alias supported by the web tracing module.
NEXT_PUBLIC_OTLP_DEBUG=false

# Next.js runtime environment. Defaults to production in deployed builds.
NODE_ENV=development

{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node"]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "src/lib/nodes/**/*",
    "src/lib/infrastructure/**/*",
    "src/lib/cluster/**/*",
    "src/lib/consensus/**/*",
    "src/lib/control-plane/**/*",
    "src/lib/tasks/**/*",
    "src/lib/capacity/**/*",
    "src/lib/cost/**/*",
    "src/lib/deployment/**/*",
    "src/lib/discovery/**/*",
    "src/lib/federated/**/*",
    "src/lib/federation/**/*",
    "src/lib/marketplace/**/*",
    "src/lib/ml/**/*",
    "src/lib/monitoring/**/*",
    "src/lib/multi-region/**/*",
    "src/lib/queue/**/*",
    "src/lib/recovery/**/*",
    "src/lib/reservation/**/*",
    "src/lib/routing/**/*",
    "src/lib/sandbox/**/*",
    "src/lib/scheduler/**/*",
    "src/lib/security/**/*",
    "src/lib/sustainability/**/*",
    "src/lib/workflow/**/*",
    "src/lib/anomaly/**/*",
    "src/lib/auth/**/*",
    "src/lib/events/**/*",
    "src/lib/metrics/**/*",
    "src/lib/observability/**/*",
    "src/lib/websocket/**/*",
    "src/lib/agent-pool.ts",
    "src/lib/executor.ts",
    "src/lib/tasks/executor.ts",
    "src/lib/database.ts",
    "src/lib/deduplication.ts",
    "src/lib/docker.ts",
    "src/lib/predictive-scheduler.ts",
    "src/lib/simulation.ts",
    "src/lib/task-queue.ts",
    "src/lib/webhook.ts",
    "src/lib/websocket-pool.ts",
    "src/lib/websocketClient.ts",
    "src/hooks/useCachedMetrics.ts"
  ]
}

# WebSocket Gateway - Environment Variables
# ==============================================================================

NODE_ENV=development
PORT=3004
LOG_LEVEL=info

# --- Gateway Configuration ---
HEARTBEAT_INTERVAL=30000
RECONNECT_BACKOFF_BASE=1000
RECONNECT_BACKOFF_MAX=30000

# --- Service Discovery ---
NODE_SERVICE_URL=http://localhost:3001
SERVICE_TOKEN=internal-default

# --- Messaging ---
REDIS_URL=redis://localhost:6379

# --- Internal Auth ---
JWT_SECRET=your-32-character-minimum-secret-key-goes-here

# --- Networking ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

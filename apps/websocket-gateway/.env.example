# ==============================================================================
# WebSocket Gateway (.env.example)
# ==============================================================================

# [OPTIONAL] Runtime environment: development | production | test (default: development)
NODE_ENV=development

# [OPTIONAL] Local HTTP/WebSocket server port (default: 3004)
PORT=3004

# [OPTIONAL] Application log severity: fatal | error | warn | info | debug | trace (default: info)
LOG_LEVEL=info

# [REQUIRED] Shared JWT secret for validating authentication tokens (min 32 chars)
JWT_SECRET=your-ws-gateway-jwt-secret-min-32-chars-long-placeholder

# [OPTIONAL] WebSocket client heartbeat ping interval in milliseconds (default: 30000)
HEARTBEAT_INTERVAL=30000

# [OPTIONAL] Base reconnection exponential backoff duration in milliseconds (default: 1000)
RECONNECT_BACKOFF_BASE=1000

# [OPTIONAL] Maximum reconnection backoff cap in milliseconds (default: 30000)
RECONNECT_BACKOFF_MAX=30000

# [OPTIONAL] Internal node service endpoint URL for node metadata discovery (default: http://localhost:3001)
NODE_SERVICE_URL=http://localhost:3001

# [OPTIONAL] Service-to-service authentication token (default: internal-default)
SERVICE_TOKEN=internal-service-token-placeholder

# [OPTIONAL] Redis connection URL for pub/sub messaging (default: redis://localhost:6379)
REDIS_URL=redis://localhost:6379

# [OPTIONAL] Comma-separated list of allowed CORS origins (default: http://localhost:5173,http://localhost:3000)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# [OPTIONAL] ISO timestamp embedded during Docker image build
# BUILD_DATE=

# [OPTIONAL] Git commit SHA embedded during Docker image build
# GIT_SHA=

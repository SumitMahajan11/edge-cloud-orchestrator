# ══════════════════════════════════════════════════════════
# Edge-Cloud Orchestrator — Environment Configuration Template
# Copy to config/.env.local and fill in your local values.
# In PRODUCTION: all values come from HashiCorp Vault or
# Kubernetes Secrets — never from .env files.
# ══════════════════════════════════════════════════════════

# ─── DATABASE (PostgreSQL 16) ───────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://edgecloud:changeme@localhost:5432/edgecloud_dev

# ─── REDIS (Cache + Event Bus + Leader Election) ─────────
# Redis 7 — used for: caching, Redis Streams events, Redlock leader election
REDIS_URL=redis://localhost:6379
# For Redis Sentinel (production HA):
# REDIS_SENTINEL_HOSTS=redis-sentinel-1:26379,redis-sentinel-2:26379
# REDIS_SENTINEL_NAME=edgecloud-redis

# ─── AUTHENTICATION ──────────────────────────────────────
# JWT_SECRET: minimum 32 characters. Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_openssl_rand_-base64_64
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ─── SERVICES (internal docker network names) ────────────
API_URL=http://api:3000
TASK_SERVICE_URL=http://task-service:3001
WEBSOCKET_GATEWAY_URL=http://websocket-gateway:3002
SCHEDULER_SERVICE_URL=http://scheduler-service:3003
NODE_SERVICE_URL=http://node-service:3004
METRICS_SERVICE_URL=http://metrics-service:3005

# ─── MTLS CONFIGURATION ──────────────────────────────────
# Set to false for local development only.
# MUST be true in staging and production.
MTLS_ENABLED=false
# Paths to certificate files (loaded by packages/security/src/tls.ts)
# In production: these are mounted from Kubernetes Secrets
MTLS_CA_PATH=/var/run/secrets/ca.crt
MTLS_CERT_PATH=/var/run/secrets/tls.crt
MTLS_KEY_PATH=/var/run/secrets/tls.key

# ─── LEADER ELECTION (Redlock via Redis) ─────────────────
# Scheduler uses Redlock distributed lock for single-leader guarantee
REDLOCK_LOCK_KEY=edgecloud:scheduler:leader
REDLOCK_LEASE_TTL_MS=15000
REDLOCK_RENEWAL_INTERVAL_MS=5000

# ─── ML SCHEDULER ────────────────────────────────────────
# Path to trained TensorFlow.js model files
# Train the model: python packages/ml-scheduler/src/training/train_model.py
ML_MODEL_PATH=packages/ml-scheduler/models
ML_PREDICTION_TIMEOUT_MS=50
ML_CONFIDENCE_THRESHOLD=0.7
# Fallback algorithm when ML confidence is below threshold: "bin-packing" or "round-robin"
ML_FALLBACK_STRATEGY=bin-packing

# ─── OBSERVABILITY ───────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
# OpenTelemetry / Jaeger tracing
JAEGER_ENDPOINT=http://jaeger:6831
OTEL_SERVICE_NAME=edgecloud

# ─── VAULT (production only — local dev does not use Vault) ──
# VAULT_ADDR=https://vault.your-domain.com
# VAULT_TOKEN=your-vault-token-here
# VAULT_PKI_PATH=pki/issue/edgecloud-services

# ─── HEARTBEAT TUNING ────────────────────────────────────
HEARTBEAT_INTERVAL_MS=5000
NODE_STALE_THRESHOLD_MS=15000
NODE_OFFLINE_THRESHOLD_MS=30000
HEARTBEAT_FLUSH_INTERVAL_MS=5000

# ─── TASK EXECUTION ──────────────────────────────────────
TASK_DEFAULT_MAX_DURATION_SECONDS=3600
TASK_CONTAINER_MEMORY_LIMIT_MB=512
TASK_CONTAINER_CPU_LIMIT=0.5

{
  "name": "edge-cloud-orchestrator",
  "version": "2.0.0",
  "description": "Production-grade distributed edge-cloud compute orchestrator",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File start.ps1 docker -Detached",
    "dev": "pnpm --parallel dev",
    "build": "pnpm -r --filter './packages/**' build && pnpm -r --filter './apps/**' build",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "pnpm --filter '@edgecloud/shared-kernel' run test -- --coverage",
    "test:integration": "vitest run tests/integration --reporter=verbose --outputFile=tests/integration/results/results.json",
    "test:smoke": "vitest run tests/smoke --reporter=verbose --outputFile=tests/smoke/results/results.json",
    "check:versions": "tsx scripts/check-sdk-version.ts",
    "test:all": "pnpm test && pnpm test:integration && pnpm check:versions",
    "test:load": "cross-env FORCE_MOCK_DB=true FORCE_MOCK_REDIS=true bash tests/load/run-load-tests.sh",
    "dev:web": "pnpm --filter @edgecloud/web dev",
    "dev:api": "pnpm --filter @edgecloud/api dev",
    "dev:agent": "pnpm --filter @edgecloud/agent dev",
    "docker:build": "docker-compose -f infra/docker/docker-compose.yml build",
    "docker:up": "docker-compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f infra/docker/docker-compose.yml down",
    "validate:migrations": "tsx scripts/validate-migration.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^8.3.1",
    "@opentelemetry/api": "^1.9.1",
    "@peculiar/x509": "^2.0.0",
    "@prisma/client": "^5.22.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@testcontainers/redis": "^11.14.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitest/coverage-v8": "^1.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "amqplib": "^0.10.9",
    "axios": "^1.15.2",
    "axios-mock-adapter": "^2.1.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.9.0",
    "cross-env": "^10.1.0",
    "dotenv": "^16.6.1",
    "eslint": "8.57.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "fast-check": "^4.7.0",
    "fastify": "^5.8.5",
    "fastify-plugin": "^4.5.1",
    "husky": "^9.1.7",
    "ioredis": "^5.10.1",
    "ioredis-mock": "^8.13.1",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "nock": "^14.0.13",
    "pg": "^8.20.0",
    "pg-mem": "^3.0.14",
    "pg-server": "^0.1.8",
    "pino": "^10.3.1",
    "pino-pretty": "^11.3.0",
    "prettier": "^3.0.0",
    "prisma": "^5.22.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "uuid": "^14.0.0",
    "vitest": "^1.6.0",
    "ws": "^8.20.0",
    "yaml": "2.8.3",
    "zod": "^4.4.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

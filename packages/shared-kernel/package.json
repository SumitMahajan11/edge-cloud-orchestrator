{
  "name": "@edgecloud/shared-kernel",
  "version": "1.0.0",
  "description": "Shared domain models, types, and utilities",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/auto-instrumentations-node": "^0.41.1",
    "@opentelemetry/exporter-jaeger": "^1.30.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.46.0",
    "@opentelemetry/resources": "^1.19.0",
    "@opentelemetry/sdk-node": "^0.46.0",
    "@opentelemetry/semantic-conventions": "^1.19.0",
    "@types/node-vault": "^0.9.13",
    "eventemitter3": "^5.0.4",
    "ioredis": "^5.3.0",
    "jsonwebtoken": "^9.0.0",
    "node-vault": "^0.12.0",
    "pino": "^9.0.0",
    "prom-client": "^15.1.3",
    "redlock": "5.0.0-beta.2",
    "uuid": "^9.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@fastify/jwt": "^7.2.4",
    "@types/ioredis": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/uuid": "^9.0.0",
    "fastify": "^4.29.1",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  }
}

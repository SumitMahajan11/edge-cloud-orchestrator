{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals", "@playwright/test"],
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@edgecloud/*": ["packages/*/src/index.ts"]
    }
  },
  "include": ["tests/**/*", "vitest.setup.ts"]
}
